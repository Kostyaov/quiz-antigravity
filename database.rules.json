{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "config": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['currentSeason', 'seasons'])"
    },
    "quizzes": {
      "$quizId": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "results": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$resultId": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['testId', 'testName', 'sessionName', 'seasonId', 'seasonName', 'userName', 'score', 'correctAnswers', 'totalQuestions', 'timestamp']) && newData.numChildren() >= 10 && newData.numChildren() <= 11",
        "testId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "testName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "sessionName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "seasonId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "seasonName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "correctAnswers": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('totalQuestions').val()"
        },
        "totalQuestions": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 200"
        },
        "timestamp": {
          ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 40"
        },
        "answers": {
          ".validate": "newData.numChildren() <= 200"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
