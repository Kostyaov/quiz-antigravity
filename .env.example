# local: зберігає конфігурацію, тести й результати лише в localStorage браузера
# firebase: підключає застосунок до Firebase, вказаної у src/firebase.js
VITE_DATA_MODE=local

# Використовується лише при VITE_DATA_MODE=local.
# Не додавайте production-пароль адміністратора до Vite env: він потрапить у браузерний bundle.
VITE_LOCAL_ADMIN_EMAIL=admin@local.test
VITE_LOCAL_ADMIN_PASSWORD=change-me-for-local-testing
